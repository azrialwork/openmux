   const out = path.join(stage, "libopentui-android-compat.so")
   const prebuilt = process.env.OPENCODE_BIONIC_SHIM
diff --git a/packages/cli/src/android-parcel.ts b/packages/cli/src/android-parcel.ts
new file mode 100644
index 0000000..760cddd
--- /dev/null
+++ b/packages/cli/src/android-parcel.ts
@@ -0,0 +1,44 @@
+import { Path } from "@opencode/util/global"
+import { mkdir, rename, rm, writeFile } from "node:fs/promises"
+import path from "node:path"
+import assets from "./parcel-android-assets"
+
+// @parcel/watcher ships an android build, but a compiled binary cannot
+// resolve it as a package, so android builds of the CLI embed the binding
+// (watcher.node) instead — see prepareParcelAndroidAssets in
+// script/build.ts. Extract it once and hand the process a real file path:
+// the watcher binding loader reads OPENCODE_PARCEL_WATCHER_PATH when the
+// watcher is first used, and the background service must inherit the
+// variable from process start, so re-exec the CLI once with it set. The
+// re-exec'd process sees the variable set and proceeds normally.
+export async function ensureParcelWatcherPath() {
+  if (process.platform !== "android" || process.env.OPENCODE_PARCEL_WATCHER_PATH || !assets) return
+  const root = path.join(Path.cache, "parcel-assets", assets.sha256.slice(0, 16))
+  const binding = path.join(root, "watcher.node")
+  if (!(await Bun.file(path.join(root, ".complete")).exists())) {
+    const staging = `${root}.tmp-${process.pid}`
+    await rm(staging, { recursive: true, force: true })
+    await mkdir(staging, { recursive: true })
+    const archive = new Bun.Archive(await Bun.file(assets.path).arrayBuffer())
+    for (const [name, blob] of await archive.files()) {
+      const relative = name.replace(/^\.\//, "")
+      if (!relative || relative.endsWith("/")) continue
+      const destination = path.join(staging, relative)
+      if (!destination.startsWith(staging + path.sep)) continue
+      await mkdir(path.dirname(destination), { recursive: true })
+      await writeFile(destination, new Uint8Array(await blob.arrayBuffer()))
+    }
+    await writeFile(path.join(staging, ".complete"), "")
+    await rm(root, { recursive: true, force: true })
+    await rename(staging, root)
+  }
+  // In a compiled binary process.argv is ["bun", "/$bunfs/root/<entry>",
+  // ...user args]; the CLI's own arguments start at index 2.
+  const result = Bun.spawnSync([process.execPath, ...process.argv.slice(2)], {
+    env: { ...process.env, OPENCODE_PARCEL_WATCHER_PATH: binding },
+    stdin: "inherit",
+    stdout: "inherit",
+    stderr: "inherit",
+  })
+  process.exit(result.exitCode ?? 1)
+}
