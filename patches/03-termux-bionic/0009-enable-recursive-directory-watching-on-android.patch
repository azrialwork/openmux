+// Prepares the @parcel/watcher binding embedded in android builds. The
+// watcher publishes an android-arm64 build (its inotify backend compiled
+// for Bionic; it links the libc++_shared.so every Termux install ships),
+// but a compiled binary has no node_modules to resolve it from, so the
+// binding is staged on its own and archived like the OpenTUI assets
+// above; src/android-parcel.ts extracts it at startup.
+async function prepareParcelAndroidAssets() {
+  const stage = path.join(outdir, ".android-parcel")
+  const tree = path.join(stage, "assets")
+  await rm(stage, { recursive: true, force: true })
+  await mkdir(tree, { recursive: true })
+  const install = path.join(stage, "install")
+  await mkdir(install, { recursive: true })
+  await writeFile(path.join(install, "package.json"), JSON.stringify({ name: "opencode-parcel-android", private: true }))
+  await $`bun install --cwd ${install} --os="android" --cpu="arm64" @parcel/watcher@${corePkg.dependencies["@parcel/watcher"]}`
+  const binding = path.join(install, "node_modules", "@parcel/watcher-android-arm64", "watcher.node")
+  if (!existsSync(binding))
+    throw new Error(`The android @parcel/watcher binding was not installed (expected at ${binding}).`)
+  await copyFile(binding, path.join(tree, "watcher.node"))
+  const archive = path.join(stage, "parcel-assets.tar")
+  run("tar", ["--sort=name", "--owner=0", "--group=0", "--numeric-owner", "--mtime=@0", "-cf", archive, "-C", tree, "."])
+  return { path: archive, sha256: createHash("sha256").update(await readFile(archive)).digest("hex") }
+}
+
