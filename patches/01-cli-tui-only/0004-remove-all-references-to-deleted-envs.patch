-    readonly initial?: Promise<readonly EnableState[] | undefined>
-    /** The installed plugins, built-ins included. */
-    list(): Promise<readonly Installed[]>
-    /**
-     * Enables a plugin.
-     *
-     * @param id - The plugin's id.
