+// Prepares the OpenTUI asset tree embedded in android builds. OpenTUI
+// publishes no android asset, but its linux-arm64-musl render library needs
+// only `libc.so` — Bionic's own SONAME — and runs on Android once three gaps
+// are bridged: libm as a separate NEEDED entry, a small compat shim for the
+// symbols Bionic lacks (script/bionic-compat.c), and OTUI_ASSET_ROOT serving
+// the tree from real files at runtime (src/android-opentui.ts). The symbol
+// audit below fails the build if a future @opentui/core changes the render
+// library's imports, so the bridge is re-verified instead of silently stale.
+async function prepareOpentuiAndroidAssets() {
+  const stage = path.join(outdir, ".android-opentui")
+  const tree = path.join(stage, "assets")
+  await rm(stage, { recursive: true, force: true })
+  const cliRequire = createRequire(path.join(dir, "package.json"))
+  const coreDir = path.dirname(cliRequire.resolve("@opentui/core/package.json"))
+  const coreRequire = createRequire(path.join(coreDir, "package.json"))
+  const muslDir = path.dirname(coreRequire.resolve("@opentui/core-linux-arm64-musl"))
+  const wasmDir = path.dirname(coreRequire.resolve("web-tree-sitter/package.json"))
+  const libDir = path.join(tree, "@opentui/core-linux-arm64-musl")
+  await mkdir(libDir, { recursive: true })
+  await mkdir(path.join(tree, "@opentui/core"), { recursive: true })
+  await mkdir(path.join(tree, "web-tree-sitter"), { recursive: true })
+  await copyFile(path.join(muslDir, "libopentui.so"), path.join(libDir, "libopentui.so"))
+  await copyFile(path.join(coreDir, "parser.worker.js"), path.join(tree, "@opentui/core", "parser.worker.js"))
+  await cp(path.join(coreDir, "assets"), path.join(tree, "@opentui/core", "assets"), { recursive: true })
+  await copyFile(path.join(wasmDir, "tree-sitter.wasm"), path.join(tree, "web-tree-sitter", "tree-sitter.wasm"))
+  const shim = await bionicCompatLibrary(stage)
+  await copyFile(shim, path.join(libDir, "libopentui-android-compat.so"))
+  await auditBionicCompat(
+    new Uint8Array(await readFile(path.join(muslDir, "libopentui.so"))),
+    new Uint8Array(await readFile(shim)),
+  )
+  const patchelf = toolPath(
+    "OPENCODE_PATCHELF",
+    "patchelf",
+    "It rewrites the staged render library's NEEDED entries for Bionic.",
+  )
+  run(patchelf, [
+    "--add-needed",
+    "libm.so",
+    "--add-needed",
+    "libopentui-android-compat.so",
+    "--set-rpath",
+    "$ORIGIN",
+    path.join(libDir, "libopentui.so"),
+  ])
+  const archive = path.join(stage, "opentui-assets.tar")
+  run("tar", ["--sort=name", "--owner=0", "--group=0", "--numeric-owner", "--mtime=@0", "-cf", archive, "-C", tree, "."])
+  return { path: archive, sha256: createHash("sha256").update(await readFile(archive)).digest("hex") }
+}
+
+async function bionicCompatLibrary(stage: string) {
+  const out = path.join(stage, "libopentui-android-compat.so")
+  const prebuilt = process.env.OPENCODE_BIONIC_SHIM
+  if (prebuilt) {
+    await copyFile(prebuilt, out)
+    return out
+  }
+  const cc = androidCompiler()
+  if (!cc)
+    throw new Error(
+      "The android target needs an aarch64-linux-android C compiler for script/bionic-compat.c: " +
+        "set OPENCODE_ANDROID_CC, or ANDROID_NDK_HOME, or provide a prebuilt library via OPENCODE_BIONIC_SHIM.",
+    )
+  run(cc[0], [
+    ...cc.slice(1),
+    path.join(dir, "script", "bionic-compat.c"),
+    "-shared",
+    "-fPIC",
+    "-O2",
+    "-Wl,-soname,libopentui-android-compat.so",
+    "-o",
+    out,
+  ])
+  return out
+}
+
+function androidCompiler() {
+  if (process.env.OPENCODE_ANDROID_CC) return process.env.OPENCODE_ANDROID_CC.split(/\s+/).filter(Boolean)
+  for (const home of [process.env.ANDROID_NDK_HOME, process.env.ANDROID_NDK_ROOT]) {
+    if (!home) continue
+    for (const host of ["linux-x86_64", "darwin-x86_64", "darwin-arm64", "windows-x86_64"]) {
+      const candidate = path.join(home, "toolchains", "llvm", "prebuilt", host, "bin", "aarch64-linux-android31-clang")
+      if (existsSync(candidate)) return [candidate]
+    }
+  }
+  if (onPath("aarch64-linux-android31-clang")) return ["aarch64-linux-android31-clang"]
+  return undefined
+}
+
+function toolPath(env: string, name: string, hint: string) {
+  const configured = process.env[env]
+  if (configured) return configured
+  if (onPath(name)) return name
+  throw new Error(`The android target needs ${name}: set ${env} to its path or put it on PATH. ${hint}`)
+}
+
+function onPath(name: string) {
+  return (process.env.PATH ?? "").split(path.delimiter).some((entry) => entry !== "" && existsSync(path.join(entry, name)))
+}
+
+function run(command: string, args: string[]) {
+  const result = spawnSync(command, args, { stdio: "inherit" })
+  if (result.status !== 0) throw new Error(`${command} ${args.join(" ")} failed`)
+}
+
+async function auditBionicCompat(lib: Uint8Array, shim: Uint8Array) {
+  const expected = new Set(
+    (await readFile(path.join(dir, "script", "opentui-musl-undefined.txt"), "utf8"))
+      .split("\n")
+      .map((line) => line.trim())
+      .filter((line) => line !== "" && !line.startsWith("#")),
+  )
+  const { undefinedSymbols } = dynamicSymbols(lib)
+  const drift = [
+    ...[...undefinedSymbols].filter((name) => !expected.has(name)).map((name) => `new import ${name}`),
+    ...[...expected].filter((name) => !undefinedSymbols.has(name)).map((name) => `missing import ${name}`),
+  ]
+  if (drift.length > 0)
+    throw new Error(
+      `libopentui.so imports drifted from script/opentui-musl-undefined.txt (${drift.join(", ")}). ` +
+        "Re-run the Bionic symbol audit, extend script/bionic-compat.c if the gap grew, and regenerate the list.",
+    )
+  const { definedSymbols } = dynamicSymbols(shim)
+  for (const name of ["__errno_location", "copy_file_range", "pthread_tryjoin_np"]) {
+    if (!undefinedSymbols.has(name))
+      throw new Error(`libopentui.so no longer imports ${name}; re-audit script/bionic-compat.c`)
+    if (!definedSymbols.has(name)) throw new Error(`script/bionic-compat.c does not export ${name}`)
+  }
+}
+
+// Minimal ELF64 little-endian dynamic-symbol reader for the audit above.
+function dynamicSymbols(bytes: Uint8Array) {
+  if (bytes.length < 64 || bytes[0] !== 0x7f || bytes[1] !== 0x45 || bytes[2] !== 0x4c || bytes[3] !== 0x46)
+    throw new Error("not an ELF file")
+  if (bytes[4] !== 2 || bytes[5] !== 1) throw new Error("expected a 64-bit little-endian ELF")
+  const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength)
+  const sectionOffset = Number(view.getBigUint64(0x28, true))
+  const sectionSize = view.getUint16(0x3a, true)
+  const sectionCount = view.getUint16(0x3c, true)
+  const sections: { type: number; offset: number; size: number; link: number; entrySize: number }[] = []
+  for (let i = 0; i < sectionCount; i++) {
+    const at = sectionOffset + i * sectionSize
+    sections.push({
+      type: view.getUint32(at + 4, true),
+      offset: Number(view.getBigUint64(at + 24, true)),
+      size: Number(view.getBigUint64(at + 32, true)),
+      link: view.getUint32(at + 40, true),
+      entrySize: Number(view.getBigUint64(at + 56, true)),
+    })
+  }
+  const dynsym = sections.find((section) => section.type === 11)
+  if (!dynsym) throw new Error("ELF has no dynamic symbol table")
+  const strings = sections[dynsym.link]
+  if (!strings) throw new Error("ELF dynamic symbol table has no string table")
+  const readString = (offset: number) => {
+    const start = strings.offset + offset
+    let end = start
+    while (bytes[end] !== 0) end++
+    return new TextDecoder().decode(bytes.subarray(start, end))
+  }
+  const undefinedSymbols = new Set<string>()
+  const definedSymbols = new Set<string>()
+  const entrySize = dynsym.entrySize || 24
+  for (let at = dynsym.offset; at + entrySize <= dynsym.offset + dynsym.size; at += entrySize) {
+    const name = readString(view.getUint32(at, true))
+    if (!name) continue
+    if (view.getUint16(at + 6, true) === 0) undefinedSymbols.add(name)
+    else definedSymbols.add(name)
+  }
+  return { undefinedSymbols, definedSymbols }
+}
+
 function targetName(item: (typeof allTargets)[number]) {
   return [
     binary,
