diff --git a/packages/cli/src/android-opentui.ts b/packages/cli/src/android-opentui.ts
new file mode 100644
index 0000000..2af656d
--- /dev/null
+++ b/packages/cli/src/android-opentui.ts
@@ -0,0 +1,43 @@
+import { Path } from "@opencode/util/global"
+import { mkdir, rename, rm, writeFile } from "node:fs/promises"
+import path from "node:path"
+import assets from "./opentui-android-assets"
+
+// OpenTUI publishes no android native asset, so android builds of the CLI
+// embed a prepared asset tree instead: the linux musl render library made
+// Bionic-compatible at build time (script/build.ts), plus the parser assets.
+// Extract it once and hand the CLI a real OTUI_ASSET_ROOT: the renderer
+// reads the variable from an environment fixed at process start, so setting
+// process.env here would not reach it — re-exec the CLI once with the
+// variable in its environment. The re-exec'd process sees the variable set
+// and proceeds normally.
+export async function ensureOpentuiAssetRoot() {
+  if (process.platform !== "android" || process.env.OTUI_ASSET_ROOT || !assets) return
+  const root = path.join(Path.cache, "opentui-assets", assets.sha256.slice(0, 16))
+  if (!(await Bun.file(path.join(root, ".complete")).exists())) {
+    const staging = `${root}.tmp-${process.pid}`
+    await rm(staging, { recursive: true, force: true })
+    await mkdir(staging, { recursive: true })
+    const archive = new Bun.Archive(await Bun.file(assets.path).arrayBuffer())
+    for (const [name, blob] of await archive.files()) {
+      const relative = name.replace(/^\.\//, "")
+      if (!relative || relative.endsWith("/")) continue
+      const destination = path.join(staging, relative)
+      if (!destination.startsWith(staging + path.sep)) continue
+      await mkdir(path.dirname(destination), { recursive: true })
+      await writeFile(destination, new Uint8Array(await blob.arrayBuffer()))
+    }
+    await writeFile(path.join(staging, ".complete"), "")
+    await rm(root, { recursive: true, force: true })
+    await rename(staging, root)
+  }
+  // In a compiled binary process.argv is ["bun", "/$bunfs/root/<entry>",
+  // ...user args]; the CLI's own arguments start at index 2.
+  const result = Bun.spawnSync([process.execPath, ...process.argv.slice(2)], {
+    env: { ...process.env, OTUI_ASSET_ROOT: root },
+    stdin: "inherit",
+    stdout: "inherit",
+    stderr: "inherit",
+  })
+  process.exit(result.exitCode ?? 1)
+}
