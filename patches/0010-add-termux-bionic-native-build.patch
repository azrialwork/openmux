diff --git a/packages/cli/script/bionic-compat.c b/packages/cli/script/bionic-compat.c
new file mode 100644
index 0000000..8464ffd
--- /dev/null
+++ b/packages/cli/script/bionic-compat.c
@@ -0,0 +1,66 @@
+// Bionic compatibility shim for the musl build of libopentui.so.
+//
+// The musl variant of OpenTUI's native library needs only `libc.so` — the
+// same SONAME as Bionic's C library — but three of its imported symbols are
+// not provided by Bionic (verified by a full undefined-symbol diff against
+// the device's libc.so + libm.so + libdl.so):
+//
+//   __errno_location   — called (11 sites). Bionic's accessor is __errno().
+//   copy_file_range    — imported but never called in @opentui/core 0.8.1
+//                        (zero call sites in all executable sections);
+//                        implemented properly via the raw syscall anyway
+//                        (Bionic only wraps it from API 34).
+//   pthread_tryjoin_np — imported but never called in @opentui/core 0.8.1
+//                        (zero call sites); Bionic has no equivalent, so
+//                        this returns EBUSY ("thread has not exited").
+//
+// libm functions (sinh, …) are covered by adding libm.so as a NEEDED entry
+// of the patched libopentui.so at build time (patchelf), not by this shim.
+
+#include <errno.h>
+#include <malloc.h>
+#include <pthread.h>
+#include <stddef.h>
+#include <sys/syscall.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+// Termux's <malloc.h> omits the mallopt declaration; Bionic libc exports it.
+int mallopt(int param, int value);
+
+#ifndef M_BIONIC_SET_HEAP_TAGGING_LEVEL
+#define M_BIONIC_SET_HEAP_TAGGING_LEVEL (-204)
+#endif
+#ifndef M_HEAP_TAGGING_LEVEL_NONE
+#define M_HEAP_TAGGING_LEVEL_NONE 0
+#endif
+
+// Bionic's scudo allocator tags heap pointers (top byte 0xB4) in app
+// processes. Hardware ignores the tag (TBI), but a tagged pointer exceeds
+// JavaScript's safe-integer range, and Bun's FFI refuses to hand it to JS —
+// which aborts OpenTUI renderer creation ("Pointer exceeds safe integer
+// range"). This shim is loaded as a dependency of libopentui.so, so its
+// constructor runs before the renderer allocates anything: turn tagging off
+// for the process.
+__attribute__((constructor)) static void openmux_bionic_compat_init(void) {
+  mallopt(M_BIONIC_SET_HEAP_TAGGING_LEVEL, M_HEAP_TAGGING_LEVEL_NONE);
+}
+
+#ifndef __NR_copy_file_range
+#define __NR_copy_file_range 326 // aarch64
+#endif
+
+int *__errno_location(void) {
+  return __errno();
+}
+
+ssize_t copy_file_range(int fd_in, off64_t *off_in, int fd_out, off64_t *off_out, size_t len,
+                        unsigned int flags) {
+  return (ssize_t)syscall(__NR_copy_file_range, fd_in, off_in, fd_out, off_out, len, flags);
+}
+
+int pthread_tryjoin_np(pthread_t thread, void **retval) {
+  (void)thread;
+  (void)retval;
+  return EBUSY;
+}
