+describe("tool policy delegation refill", () => {
+  const exhaust = Effect.fnUntraced(function* (hooks: Hooks, sessionID: Session.ID, agent: Agent.ID) {
+    yield* hooks.contextHook(request(sessionID, agent, [Message.user("start")]))
+    for (let i = 0; i < MAX_EXPLORATION_CALLS; i++) yield* completeCall(hooks, sessionID, agent, "read")
+  })
+
+  it.effect("refills after a completed substantive foreground delegation, including follow-ups", () =>
+    Effect.gen(function* () {
+      const hooks = yield* runPolicy()
+      const sessionID = Session.ID.make("ses_policy_refill_fg")
+      yield* exhaust(hooks, sessionID, build)
+      expect(yield* hooks.beforeHook(before(sessionID, build, "read")).pipe(Effect.flip)).toBeInstanceOf(ToolFailure)
+      yield* settleSubagent(hooks, sessionID, build, { agent: "explore", prompt: briefing }, {
+        sessionID: "ses_child_fg",
+        status: "completed",
+        output: "Findings.",
+      })
+      // The full budget is available again.
+      for (let i = 0; i < MAX_EXPLORATION_CALLS; i++) yield* completeCall(hooks, sessionID, build, "read")
+      expect(yield* hooks.beforeHook(before(sessionID, build, "read")).pipe(Effect.flip)).toBeInstanceOf(ToolFailure)
+      // A follow-up to an existing child counts the same way.
+      yield* settleSubagent(
+        hooks,
+        sessionID,
+        build,
+        { agent: "explore", prompt: briefing, sessionID: "ses_child_fg" },
+        { sessionID: "ses_child_fg", status: "completed", output: "More findings." },
+      )
+      yield* hooks.beforeHook(before(sessionID, build, "read"))
+    }),
+  )
+
+  it.effect("does not refill for delegations that are trivial, empty, or failed", () =>
+    Effect.gen(function* () {
+      const hooks = yield* runPolicy()
+      const stillExhausted = (sessionID: Session.ID, agent: Agent.ID) =>
+        hooks.beforeHook(before(sessionID, agent, "read")).pipe(Effect.flip)
+
+      // A ten-character prompt is not a briefing, however well the child does.
+      const short = Session.ID.make("ses_policy_short_prompt")
+      yield* exhaust(hooks, short, build)
+      yield* settleSubagent(hooks, short, build, { agent: "explore", prompt: "1234567890" }, {
+        sessionID: "ses_child_short",
+        status: "completed",
+        output: "Findings.",
+      })
+      expect(yield* stillExhausted(short, build)).toBeInstanceOf(ToolFailure)
+
+      // A child that completed without a text response did no delegable work.
+      const silent = Session.ID.make("ses_policy_no_text")
+      yield* exhaust(hooks, silent, build)
+      yield* settleSubagent(hooks, silent, build, { agent: "explore", prompt: briefing }, {
+        sessionID: "ses_child_silent",
+        status: "completed",
+        output: SubagentCompletion.NO_TEXT,
+      })
+      expect(yield* stillExhausted(silent, build)).toBeInstanceOf(ToolFailure)
+
+      // Neither did one whose output is empty.
+      const empty = Session.ID.make("ses_policy_empty_output")
+      yield* exhaust(hooks, empty, build)
+      yield* settleSubagent(hooks, empty, build, { agent: "explore", prompt: briefing }, {
+        sessionID: "ses_child_empty",
+        status: "completed",
+        output: "  ",
+      })
+      expect(yield* stillExhausted(empty, build)).toBeInstanceOf(ToolFailure)
+
+      // A delegation that errors never refills.
+      const failed = Session.ID.make("ses_policy_failed_delegation")
+      yield* exhaust(hooks, failed, build)
+      yield* hooks.afterHook(
+        toolError(failed, build, "subagent", new ToolFailure({ message: "Subagent failed" }), {
+          agent: "explore",
+          prompt: briefing,
+        }),
+      )
+      expect(yield* stillExhausted(failed, build)).toBeInstanceOf(ToolFailure)
+    }),
+  )
+
+  it.effect("lets build refill through general, but plan only through explore", () =>
+    Effect.gen(function* () {
+      const hooks = yield* runPolicy()
+      const viaGeneral = Session.ID.make("ses_policy_via_general")
+      yield* exhaust(hooks, viaGeneral, build)
+      yield* settleSubagent(hooks, viaGeneral, build, { agent: "general", prompt: briefing }, {
+        sessionID: "ses_child_general",
+        status: "completed",
+        output: "Done.",
+      })
+      yield* hooks.beforeHook(before(viaGeneral, build, "read"))
+
+      const planSession = Session.ID.make("ses_policy_plan_targets")
+      yield* exhaust(hooks, planSession, plan)
+      yield* settleSubagent(hooks, planSession, plan, { agent: "general", prompt: briefing }, {
+        sessionID: "ses_child_plan_general",
+        status: "completed",
+        output: "Done.",
+      })
+      expect(yield* hooks.beforeHook(before(planSession, plan, "read")).pipe(Effect.flip)).toBeInstanceOf(ToolFailure)
+      yield* settleSubagent(hooks, planSession, plan, { agent: "explore", prompt: briefing }, {
+        sessionID: "ses_child_plan_explore",
+        status: "completed",
+        output: "Done.",
+      })
+      yield* hooks.beforeHook(before(planSession, plan, "read"))
+    }),
+  )
+
+  it.effect("settles a background delegation only when its completion synthetic lands", () =>
+    Effect.gen(function* () {
+      const hooks = yield* runPolicy()
+      const sessionID = Session.ID.make("ses_policy_background")
+      yield* exhaust(hooks, sessionID, build)
+      // The launch alone settles nothing: the tools stay pruned.
+      yield* settleSubagent(
+        hooks,
+        sessionID,
+        build,
+        { agent: "explore", prompt: briefing, background: true },
+        { sessionID: "ses_child_bg", status: "running", output: "The subagent is working in the background." },
+      )
+      const pruned = toolsMap(fullToolset)
+      yield* hooks.contextHook(request(sessionID, build, [Message.user("start")], pruned))
+      expect(Object.keys(pruned).sort()).toEqual(["question", "subagent"])
+      // The completion synthetic claims the credit and refills.
+      const restored = toolsMap(fullToolset)
+      yield* hooks.contextHook(
+        request(
+          sessionID,
+          build,
+          [
+            Message.user("start"),
+            Message.user(
+              '<subagent sessionID="ses_child_bg" state="completed" description="Map pricing">Findings.</subagent>',
+            ),
+          ],
+          restored,
+        ),
+      )
+      expect(Object.keys(restored).sort()).toEqual([...fullToolset].sort())
+      yield* hooks.beforeHook(before(sessionID, build, "read"))
+    }),
+  )
+
+  it.effect("drops a background credit whose child fails or whose launch was trivial", () =>
+    Effect.gen(function* () {
+      const hooks = yield* runPolicy()
+      const failedSession = Session.ID.make("ses_policy_background_failed")
+      yield* exhaust(hooks, failedSession, build)
+      yield* settleSubagent(
+        hooks,
+        failedSession,
+        build,
+        { agent: "explore", prompt: briefing, background: true },
+        { sessionID: "ses_child_bg_failed", status: "running", output: "The subagent is working in the background." },
+      )
+      yield* hooks.contextHook(
+        request(failedSession, build, [
+          Message.user("start"),
+          Message.user(
+            '<subagent sessionID="ses_child_bg_failed" state="error" description="Map pricing">Subagent failed</subagent>',
+          ),
+        ]),
+      )
+      expect(yield* hooks.beforeHook(before(failedSession, build, "read")).pipe(Effect.flip)).toBeInstanceOf(
+        ToolFailure,
+      )
+
+      // A launch whose prompt never qualified records no credit for its completion to claim.
+      const trivialSession = Session.ID.make("ses_policy_background_trivial")
+      yield* exhaust(hooks, trivialSession, build)
+      yield* settleSubagent(
+        hooks,
+        trivialSession,
+        build,
+        { agent: "explore", prompt: "1234567890", background: true },
+        { sessionID: "ses_child_bg_trivial", status: "running", output: "The subagent is working in the background." },
+      )
+      yield* hooks.contextHook(
+        request(trivialSession, build, [
+          Message.user("start"),
+          Message.user(
+            '<subagent sessionID="ses_child_bg_trivial" state="completed" description="Quick look">Findings.</subagent>',
+          ),
+        ]),
+      )
+      expect(yield* hooks.beforeHook(before(trivialSession, build, "read")).pipe(Effect.flip)).toBeInstanceOf(
+        ToolFailure,
+      )
+    }),
+  )
+})
+
