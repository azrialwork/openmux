index 0000000..130e614
--- /dev/null
+++ b/packages/core/src/plugin/tool-policy.ts
@@ -0,0 +1,303 @@
+export * as ToolPolicyPlugin from "./tool-policy.js"
+
+import { Message, ToolFailure } from "@opencode/ai/effect"
+import { define } from "@opencode/plugin/effect/plugin"
+import { Agent } from "@opencode/schema/agent"
+import type { SessionContext } from "@opencode/plugin/effect/session"
+import { Effect, Predicate } from "effect"
+import { Permission } from "../permission.js"
+import { SubagentCompletion } from "../session/subagent-completion.js"
+
+// Code enforcement for the two behaviours the agent prompts alone did not produce (patch
+// 0009): primary agents delegate exploration instead of doing it all themselves, and every
+// tool is used for its designated job — the shell never substitutes for the dedicated file
+// tools. The fences themselves live in permissions (plugin/agent.ts, plugin/plan.ts); this
+// plugin adds the parts permissions cannot express: a per-turn exploration budget for Build
+// and Plan whose top rung removes every tool but subagent and question from the model's
+// view (delegation mode), refills earned only by delegations that complete with substance,
+// and denial messages that name the designated tool so the model can correct itself.
+
+/** Direct exploration calls per user turn that are always free: quick known-path lookups. */
+export const FREE_EXPLORATION_CALLS = 4
+/** The completed direct exploration call in a turn at which the delegation reminder is injected. */
+export const REMIND_AT = FREE_EXPLORATION_CALLS + 1
+/** Completed direct exploration calls allowed per user turn; at this count delegation mode begins. */
+export const MAX_EXPLORATION_CALLS = 8
+/** The shortest delegation prompt that counts as substantive work once the delegation completes. */
+export const MIN_DELEGATION_PROMPT_CHARS = 40
+
+const build = Agent.ID.make("build")
+const plan = Agent.ID.make("plan")
+const general = Agent.ID.make("general")
+
+const exploration = new Set(["read", "glob", "grep"])
+
+const reminder = `[system-reminder] You have made ${REMIND_AT} direct exploration calls this turn without delegating. Delegate remaining exploration to the Explore subagent, and independent multi-step work to General. Reads of files you already know remain available within a small remaining budget.`
+
+const budgetError = `Exploration budget for this turn is exhausted (${MAX_EXPLORATION_CALLS} direct calls). Use the \`subagent\` tool (agent: \`explore\`) for further exploration; the budget refills after a delegation.`
+
+const delegationModeDescription = `REQUIRED NEXT ACTION — your direct tool budget for this turn is exhausted. Delegate now: exploration to the Explore subagent, independent multi-step work to General. Your full tool set returns after a delegation completes.`
+
+interface State {
+  /** Exploration calls that completed this user turn; drives the ladder and delegation mode. */
+  exploration: number
+  /**
+   * Exploration attempts currently executing. Reserved in execute.before so one parallel
+   * block cannot overshoot the ladder, and returned in execute.after when an attempt errors,
+   * so failed calls never consume the budget.
+   */
+  inFlight: number
+  reminded: boolean
+  remindPending: boolean
+  userTurnsSeen: number
+  /**
+   * Background delegations launched with a qualifying prompt and target, keyed by child
+   * session id, awaiting the completion synthetic that settles their refill credit.
+   */
+  pendingBackground: Set<string>
+}
+
+const refill = (state: State) => {
+  state.exploration = 0
+  state.inFlight = 0
+  state.reminded = false
+  state.remindPending = false
+}
+
+// User-role transcript entries that are not user turns: harness synthetics and compaction
+// checkpoints arrive as user messages without a structural marker (see session/runner/
+// to-llm-message.ts), so they are recognised by their stable text prefixes, the same way
+// plan.ts recognises its own reminders.
+const syntheticPrefixes = ["[system-reminder", "<conversation-checkpoint>", "<subagent ", "<shell ", "Instructions from: "]
+
+const textOf = (message: Message) =>
+  message.content
+    .filter((part) => part.type === "text")
+    .map((part) => part.text)
+    .join("")
+
+const isUserTurn = (message: Message) => {
+  if (message.role !== "user") return false
+  return !syntheticPrefixes.some((prefix) => textOf(message).startsWith(prefix))
+}
+
+const userTurns = (messages: SessionContext["messages"]) => messages.filter(isUserTurn).length
+
+// The first command word of a shell segment: environment assignments are skipped and a
+// path prefix is dropped, so `/usr/bin/cat` and `FOO=1 cat` both resolve to `cat`.
+const commandOf = (segment: string) => {
+  const word = segment
+    .trim()
+    .split(/\s+/)
+    .find((word) => !/^[A-Za-z_][A-Za-z0-9_]*=/.test(word))
+  return word?.replace(/^.*\//, "").replace(/^["']|["']$/g, "")
+}
+
+const guidance: ReadonlyArray<{
+  readonly commands: ReadonlySet<string>
+  readonly text: string
+  // Build has no glob/grep tools (patch 0009 removes them from the primaries' catalogs),
+  // so for Build the pointer must name the route it actually has: read what it knows,
+  // and delegate discovery to the Explore subagent.
+  readonly primaryText?: string
+}> = [
+  {
+    commands: new Set(["cat", "head", "tail", "less", "more"]),
+    text: "Use the `read` tool instead: it is the designated tool for reading file contents and returns numbered lines.",
+  },
+  {
+    commands: new Set(["ls", "find", "tree"]),
+    text: "Use the `glob` tool to find files by pattern, or the `read` tool on a directory to list it.",
+    primaryText:
+      "Use the `read` tool on a directory to list it. Finding files by pattern across the project is delegated work: use the `subagent` tool (agent: `explore`) — this agent has no `glob` tool.",
+  },
+  {
+    commands: new Set(["grep", "rg", "ag", "ack"]),
+    text: "Use the `grep` tool instead: it is the designated tool for searching file contents.",
+    primaryText:
+      "Searching file contents is delegated work: use the `subagent` tool (agent: `explore`) — this agent has no `grep` tool. Use the `read` tool for files whose path you already know.",
+  },
+  {
+    commands: new Set(["sed"]),
+    text: "Use the `edit` tool (or `write`/`patch`) instead: shell in-place editing is blocked.",
+  },
+]
+
+// Turns a shell denial caused by a hygiene rule into guidance naming the designated tool.
+// Returns undefined for denials the hygiene rules did not cause, leaving them untouched.
+const hygieneGuidance = (resources: ReadonlyArray<string>, agent: Agent.ID) => {
+  for (const resource of resources) {
+    const command = commandOf(resource)
+    if (!command) continue
+    if ((command === "echo" || command === "printf") && resource.includes(">"))
+      return `Shell command \`${command}\` is blocked for this agent. Use the \`write\` tool instead: shell redirection is blocked for writing files.`
+    const match = guidance.find((entry) => entry.commands.has(command))
+    if (match)
+      return `Shell command \`${command}\` is blocked for this agent. ${agent === build && match.primaryText ? match.primaryText : match.text}`
+  }
+  return undefined
+}
+
+// A delegation earns a refill only when it is substantive on its face: the target is a real
+// worker for the caller (Plan may only use Explore) and the briefing is long enough to
+// describe actual work. Whether it also completed is checked separately at settle time.
+const delegationQualifies = (caller: Agent.ID, input: unknown) => {
+  if (!Predicate.isObject(input)) return false
+  if (input.agent !== "explore" && !(caller === build && input.agent === "general")) return false
+  return typeof input.prompt === "string" && input.prompt.trim().length >= MIN_DELEGATION_PROMPT_CHARS
+}
+
+// The settled shape of a subagent tool call, read from its result: a foreground call that
+// ran to completion reports status "completed" with the child's output text; a launch —
+// background from the start, or a foreground call the user pushed to the background —
+// reports status "running" with the child session id and no output yet.
+const subagentOutcome = (result: unknown) => {
+  if (!Predicate.isObject(result)) return undefined
+  const output = result.output
+  if (!Predicate.isObject(output)) return undefined
+  const metadata = Predicate.isObject(result.metadata) ? result.metadata : undefined
+  const sessionID = typeof output.sessionID === "string" ? output.sessionID : metadata?.sessionID
+  return {
+    status: typeof output.status === "string" ? output.status : undefined,
+    output: typeof output.output === "string" ? output.output : undefined,
+    sessionID: typeof sessionID === "string" ? sessionID : undefined,
+  }
+}
+
+// Background completion synthetics are delivered to the parent as user messages of the form
+// `<subagent sessionID="..." state="...">` (session/subagent-completion.ts); the delivered
+// states are "completed", "error", and "cancelled".
+const completionPattern = /<subagent sessionID="([^"]+)" state="([^"]+)"/
+
+export const Plugin = define({
+  id: "opencode.tool.policy",
+  effect: Effect.fn(function* (ctx) {
+    const states = new Map<string, State>()
+    const stateFor = (sessionID: string): State => {
+      const current = states.get(sessionID)
+      if (current) return current
+      const next: State = {
+        exploration: 0,
+        inFlight: 0,
+        reminded: false,
+        remindPending: false,
+        userTurnsSeen: 0,
+        pendingBackground: new Set(),
+      }
+      states.set(sessionID, next)
+      return next
+    }
+
+    // Budget backstop. Counting happens on completion (the execute.after hook below); this
+    // hook only reserves a slot per attempt so a single parallel block — whose calls share
+    // one pre-built tools map and so cannot see each other's completions — cannot overshoot
+    // the ladder, and rejects calls once the turn's allowance is spoken for. Governance is
+    // decided from the payload alone and must never break a session, so the computation is
+    // total and fail-open: a blocked call is produced only by the explicit decision below,
+    // never by an incidental failure.
+    yield* ctx.tool.hook("execute.before", (event) =>
+      Effect.gen(function* () {
+        const blocked = yield* Effect.sync(() => {
+          if (event.agent !== build && event.agent !== plan) return undefined
+          if (!exploration.has(event.tool)) return undefined
+          const state = stateFor(event.sessionID)
+          if (state.exploration + state.inFlight >= MAX_EXPLORATION_CALLS) return budgetError
+          state.inFlight += 1
+          return undefined
+        }).pipe(Effect.catchCause(() => Effect.succeed(undefined)))
+        if (blocked) return yield* new ToolFailure({ message: blocked })
+      }),
+    )
+
+    // One after hook does both jobs: budget accounting and delegation settlement for
+    // Build and Plan, and hygiene guidance for Build and General (their shell denials for
+    // reading, finding, searching, and in-place editing are rewritten into pointers to the
+    // designated tool; General is not budget-governed, but its shell carries the same
+    // hygiene denies).
+    yield* ctx.tool.hook("execute.after", (event) =>
+      Effect.sync(() => {
+        if (event.agent === build || event.agent === plan) {
+          const state = stateFor(event.sessionID)
+          if (exploration.has(event.tool)) {
+            state.inFlight = Math.max(0, state.inFlight - 1)
+            if (event.status === "completed") {
+              state.exploration += 1
+              if (state.exploration === REMIND_AT) state.remindPending = true
+            }
+          } else if (event.tool === "subagent" && event.status === "completed") {
+            const outcome = subagentOutcome(event.result)
+            if (outcome?.status === "running") {
+              // A launch settles nothing; it only records a credit the child's completion
+              // synthetic can later claim, and only if the delegation was substantive.
+              if (outcome.sessionID && delegationQualifies(event.agent, event.input))
+                state.pendingBackground.add(outcome.sessionID)
+            } else if (outcome?.status === "completed" && delegationQualifies(event.agent, event.input)) {
+              // A child that finished without saying anything did no delegable work.
+              const text = outcome.output?.trim()
+              if (text && text !== SubagentCompletion.NO_TEXT) refill(state)
+            }
+          }
+        }
+        if (event.agent !== build && event.agent !== general) return
+        if (event.status !== "error") return
+        if (event.tool !== "shell") return
+        if (!(event.error.error instanceof Permission.BlockedError)) return
+        const message = hygieneGuidance(event.error.error.resources, event.agent)
+        if (message) event.error = new ToolFailure({ message })
+      }).pipe(Effect.catchCause(() => Effect.void)),
+    )
+
+    // Turn tracking, background settlement, the delegation reminder, and delegation mode.
+    // A new user turn refills the budget; a pending reminder is spliced in once,
+    // ephemerally like the goal plugin's reminder, so it never persists into the transcript
+    // it comments on; and once the budget is spent, every tool but subagent and question is
+    // removed from the request's tools map — rebuilt from state on every request, so the
+    // full set returns on its own after a refill or a new turn.
+    yield* ctx.session.hook("context", (event) =>
+      Effect.sync(() => {
+        if (event.agent !== build && event.agent !== plan) return
+        const state = stateFor(event.sessionID)
+        // A context request is prepared between steps, when the previous step's calls have
+        // settled; a reservation still marked in flight belongs to a call whose after hook
+        // never ran (a defect, an interruption, or the not-available path in tool.ts) and
+        // is released rather than left to leak into the rest of the turn.
+        state.inFlight = 0
+        const turns = userTurns(event.messages)
+        if (turns !== state.userTurnsSeen) {
+          // A shrink means compaction or a revert rewrote history: adopt the new count so
+          // the next genuine user message registers as a new turn.
+          if (turns > state.userTurnsSeen) {
+            refill(state)
+            state.pendingBackground.clear()
+          }
+          state.userTurnsSeen = turns
+        }
+        // Settle background delegations whose completion synthetic has landed.
+        if (state.pendingBackground.size > 0) {
+          for (const message of event.messages) {
+            if (message.role !== "user") continue
+            const match = completionPattern.exec(textOf(message))
+            if (!match?.[1] || !state.pendingBackground.delete(match[1])) continue
+            if (match[2] === "completed") refill(state)
+          }
+        }
+        if (state.remindPending && !state.reminded) {
+          state.remindPending = false
+          state.reminded = true
+          const at = event.messages.at(-1)?.role === "user" ? event.messages.length - 1 : event.messages.length
+          event.messages.splice(at, 0, Message.user(reminder))
+        }
+        if (state.exploration < MAX_EXPLORATION_CALLS) return
+        // Delegation mode: the model keeps exactly the two tools that end the mode or
+        // escalate to the user. Everything else — including the Code Mode entry tool — is
+        // deleted from this request's map, so the calls are not merely blocked but absent.
+        for (const name of Object.keys(event.tools)) {
+          if (name !== "subagent" && name !== "question") delete event.tools[name]
+        }
+        const subagent = event.tools["subagent"]
+        if (subagent && !subagent.description.startsWith("REQUIRED NEXT ACTION"))
+          subagent.description = `${delegationModeDescription}\n\n${subagent.description}`
+      }).pipe(Effect.catchCause(() => Effect.void)),
+    )
+  }),
+})
