+describe("tool policy shell guidance", () => {
+  it.effect("rewrites hygiene denials into pointers to the designated tool", () =>
+    Effect.gen(function* () {
+      const { afterHook } = yield* runPolicy()
+      const sessionID = Session.ID.make("ses_policy_guidance")
+      const cases: ReadonlyArray<{ agent: Agent.ID; resources: ReadonlyArray<string>; expected: string }> = [
+        {
+          agent: build,
+          resources: ["cat file.txt"],
+          expected:
+            "Shell command `cat` is blocked for this agent. Use the `read` tool instead: it is the designated tool for reading file contents and returns numbered lines.",
+        },
+        {
+          // Build has no glob tool: its pointer names read-on-directory and delegation instead.
+          agent: build,
+          resources: ["ls -la"],
+          expected:
+            "Shell command `ls` is blocked for this agent. Use the `read` tool on a directory to list it. Finding files by pattern across the project is delegated work: use the `subagent` tool (agent: `explore`) — this agent has no `glob` tool.",
+        },
+        {
+          agent: general,
+          resources: ["ls -la"],
+          expected:
+            "Shell command `ls` is blocked for this agent. Use the `glob` tool to find files by pattern, or the `read` tool on a directory to list it.",
+        },
+        {
+          // Build has no grep tool either: content search is delegated to Explore.
+          agent: build,
+          resources: ["grep -r foo ."],
+          expected:
+            "Shell command `grep` is blocked for this agent. Searching file contents is delegated work: use the `subagent` tool (agent: `explore`) — this agent has no `grep` tool. Use the `read` tool for files whose path you already know.",
+        },
+        {
+          agent: general,
+          resources: ["grep -r foo ."],
+          expected:
+            "Shell command `grep` is blocked for this agent. Use the `grep` tool instead: it is the designated tool for searching file contents.",
+        },
+        {
+          agent: build,
+          resources: ["sed -i 's/a/b/' file.txt"],
+          expected:
+            "Shell command `sed` is blocked for this agent. Use the `edit` tool (or `write`/`patch`) instead: shell in-place editing is blocked.",
+        },
+        {
+          agent: build,
+          resources: ["echo hello > out.txt"],
+          expected:
+            "Shell command `echo` is blocked for this agent. Use the `write` tool instead: shell redirection is blocked for writing files.",
+        },
+        {
+          // The hygiene segment is found among the resources of a compound command.
+          agent: build,
+          resources: ["cd /project", "cat y"],
+          expected:
+            "Shell command `cat` is blocked for this agent. Use the `read` tool instead: it is the designated tool for reading file contents and returns numbered lines.",
+        },
+      ]
+      for (const item of cases) {
+        const event = toolError(sessionID, item.agent, "shell", blockedShell(item.resources))
+        yield* afterHook(event)
+        expect(event.error.message).toBe(item.expected)
+      }
+    }),
+  )
+
+  it.effect("leaves denials the hygiene rules did not cause untouched", () =>
+    Effect.gen(function* () {
+      const { afterHook } = yield* runPolicy()
+      const sessionID = Session.ID.make("ses_policy_untouched")
+      // A shell denial for another reason (here: a configured rm deny).
+      const rm = toolError(sessionID, build, "shell", blockedShell(["rm -rf build"]))
+      const rmError = rm.error
+      yield* afterHook(rm)
+      expect(rm.error).toBe(rmError)
+      // Plan's shell is denied outright by its own rules; the plan plugin owns that message.
+      const planEvent = toolError(sessionID, plan, "shell", blockedShell(["cat file.txt"]))
+      const planError = planEvent.error
+      yield* afterHook(planEvent)
+      expect(planEvent.error).toBe(planError)
+      // Non-shell errors are never rewritten.
+      const read = toolError(
+        sessionID,
+        build,
+        "read",
+        new ToolFailure({
+          message: "Permission denied: read",
+          error: new Permission.BlockedError({ rules: [], permission: "read", resources: ["secret.txt"] }),
+        }),
+      )
+      const readError = read.error
+      yield* afterHook(read)
+      expect(read.error).toBe(readError)
+    }),
+  )
+})
