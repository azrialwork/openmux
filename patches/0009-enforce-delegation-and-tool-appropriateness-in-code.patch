+describe("tool policy delegation mode", () => {
+  it.effect("removes every tool but subagent and question once the budget is spent, and restores them after a refill", () =>
+    Effect.gen(function* () {
+      const hooks = yield* runPolicy()
+      const sessionID = Session.ID.make("ses_policy_mode")
+      yield* hooks.contextHook(request(sessionID, build, [Message.user("start")]))
+      for (let i = 0; i < MAX_EXPLORATION_CALLS; i++) yield* completeCall(hooks, sessionID, build, "read")
+      const pruned = toolsMap(fullToolset)
+      yield* hooks.contextHook(request(sessionID, build, [Message.user("start")], pruned))
+      expect(Object.keys(pruned).sort()).toEqual(["question", "subagent"])
+      expect(pruned["subagent"]?.description).toContain("REQUIRED NEXT ACTION")
+      expect(pruned["subagent"]?.description).toContain("your direct tool budget for this turn is exhausted")
+      // A completed, substantive delegation ends the mode: the next request offers everything.
+      yield* settleSubagent(hooks, sessionID, build, { agent: "explore", prompt: briefing }, {
+        sessionID: "ses_child_mode",
+        status: "completed",
+        output: "The pricing module consists of four files.",
