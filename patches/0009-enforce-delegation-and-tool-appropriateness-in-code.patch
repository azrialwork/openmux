+++ b/packages/core/test/plugin/tool-policy.test.ts
@@ -0,0 +1,830 @@
+import { describe, expect } from "bun:test"
+import { Message, ToolFailure } from "@opencode/ai/effect"
+import { Effect, Schema, Types } from "effect"
+import type { AgentEditor } from "@opencode/plugin/effect/agent"
+import type { SessionContext } from "@opencode/plugin/effect/session"
+import type { ToolHooks } from "@opencode/plugin/effect/tool"
+import { Agent } from "@opencode/core/agent"
+import { AppNodeBuilder } from "@opencode/core/effect/app-node-builder"
+import { Environment } from "@opencode/core/environment/index"
+import { Location } from "@opencode/core/location"
+import { Model } from "@opencode/core/model"
+import { Permission } from "@opencode/core/permission"
+import { AgentPlugin } from "@opencode/core/plugin/agent"
+import { PlanPlugin } from "@opencode/core/plugin/plan"
+import {
+  MAX_EXPLORATION_CALLS,
+  REMIND_AT,
+  ToolPolicyPlugin,
+} from "@opencode/core/plugin/tool-policy"
+import { Provider } from "@opencode/core/provider"
+import { AbsolutePath } from "@opencode/core/schema"
+import { Session } from "@opencode/core/session"
+import { SessionMessage } from "@opencode/core/session/message"
+import { SubagentCompletion } from "@opencode/core/session/subagent-completion"
+import { ShellParse } from "@opencode/core/shell/parse"
+import { Tool } from "@opencode/core/tool"
+import { Global } from "@opencode/util/global"
+import { it } from "../lib/effect"
+import { host } from "./host"
+
+const build = Agent.ID.make("build")
+const plan = Agent.ID.make("plan")
+const general = Agent.ID.make("general")
+const explore = Agent.ID.make("explore")
+const home = "/home/tool-policy-test"
+
+/** Applies the built-in agent plugins to default agent infos, keyed by agent id. */
+const buildAgents = Effect.fnUntraced(function* () {
+  const agents = new Map<string, Types.DeepMutable<Agent.Info>>()
+  const editor: AgentEditor = {
+    list: () => Array.from(agents.values()),
+    get: (id) => agents.get(id),
+    default: () => {},
+    update: (id, update) => {
+      const defaults = Agent.Info.default(Agent.ID.make(id))
+      const current = agents.get(id) ?? { ...defaults, permissions: [...defaults.permissions] }
+      update(current)
+      agents.set(id, current)
+    },
+    remove: (id) => {
+      agents.delete(id)
+    },
+  }
+  const agent = {
+    get: () => Effect.die("unused agent.get"),
+    list: () => Effect.die("unused agent.list"),
+    reload: () => Effect.die("unused agent.reload"),
+    transform: (callback: (editor: AgentEditor) => void) => {
+      callback(editor)
+      return Effect.succeed({ dispose: Effect.void })
+    },
+  }
+  yield* AgentPlugin.Plugin.effect(host({ agent }))
+  const driver = Environment.makeMemoryDriver()
+  yield* PlanPlugin.Plugin.effect(
+    host({
+      agent,
+      tool: {
+        transform: () => Effect.die("unused tool.transform"),
+        reload: () => Effect.die("unused tool.reload"),
+        list: () => Effect.die("unused tool.list"),
+        hook: () => Effect.succeed({ dispose: Effect.void }),
+      },
+      session: { hook: () => Effect.succeed({ dispose: Effect.void }) },
+    }),
+  ).pipe(
+    Effect.provideService(Global.Service, Global.Service.of({ ...Global.make(), home })),
+    Effect.provideService(
+      Environment.Service,
+      Environment.Service.of({ files: Environment.makeFiles(driver), spawner: driver.spawner }),
+    ),
+  )
+  return agents
+})
+
+const rulesFor = (agents: Map<string, Types.DeepMutable<Agent.Info>>, id: Agent.ID) => {
+  const info = agents.get(id)
+  if (!info) throw new Error(`agent not built: ${id}`)
+  return info.permissions
+}
+
+/**
+ * The effect Permission.assert settles on for a shell command: the real parser's segments,
+ * each evaluated against the ruleset, aggregated the way Permission.assert aggregates them
+ * (any denied segment denies the call, otherwise any ask asks).
+ */
+const shellEffect = (rules: Permission.Ruleset, command: string) =>
+  ShellParse.scan(command, "bash", "/project").pipe(
+    Effect.map((parsed) => {
+      const effects = parsed.commands.map((segment) => Permission.evaluate("shell", segment.resource, rules).effect)
+      return effects.includes("deny") ? "deny" : effects.includes("ask") ? "ask" : "allow"
+    }),
+  )
+
+describe("agent permission rules", () => {
+  it.effect("denies shell segments whose work belongs to a dedicated tool, for build and general", () =>
+    Effect.gen(function* () {
+      const agents = yield* buildAgents()
+      for (const id of [build, general]) {
+        const rules = rulesFor(agents, id)
+        for (const command of [
+          "cat file.txt",
+          "head -5 file.txt",
+          "tail -5 file.txt",
+          "ls -la",
+          "find . -name '*.ts'",
+          "grep -r foo src",
+          "rg foo",
+          "sed -i 's/a/b/' file.txt",
+          "sed --in-place 's/a/b/' file.txt",
+          "echo hello > out.txt",
+          "printf 'x' > out.txt",
+          // A denied segment denies the whole compound command.
+          "cd sub && cat y",
+          "bun test | grep FAIL",
+        ]) {
+          expect(yield* shellEffect(rules, command)).toBe("deny")
+        }
+        for (const command of ["git log --oneline", "git status", "bun test", "bun run build", "echo hello"]) {
+          expect(yield* shellEffect(rules, command)).toBe("allow")
+        }
+      }
+    }),
+  )
+
+  it.effect("removes glob and grep from build and plan only", () =>
+    Effect.gen(function* () {
+      const agents = yield* buildAgents()
+      for (const id of [build, plan]) {
+        const rules = rulesFor(agents, id)
+        expect(Permission.evaluate("glob", "src/**/*.ts", rules).effect).toBe("deny")
+        expect(Permission.evaluate("grep", "foo", rules).effect).toBe("deny")
+        expect(Permission.evaluate("read", "src/index.ts", rules).effect).toBe("allow")
+      }
+      for (const id of [general, explore]) {
+        const rules = rulesFor(agents, id)
+        expect(Permission.evaluate("glob", "src/**/*.ts", rules).effect).toBe("allow")
+        expect(Permission.evaluate("grep", "foo", rules).effect).toBe("allow")
+      }
+    }),
+  )
+})
+
+const toolNode = AppNodeBuilder.build(Tool.node, [
+  Location.node.replace(Location.boundNode({ directory: AbsolutePath.make("/project") })),
+])
+
+describe("tool catalog", () => {
+  it.effect("snapshots for build and plan exclude glob and grep; explore and general keep them", () =>
+    Effect.gen(function* () {
+      const agents = yield* buildAgents()
+      const tools = yield* Tool.Service
+      yield* tools.transform((editor) => {
+        for (const name of ["glob", "grep", "read"]) {
+          editor.add({
+            name,
+            description: name,
+            input: Schema.Struct({}),
+            options: { codemode: false },
+            execute: () => Effect.succeed({ content: "ok" }),
+          })
+        }
+      })
+      const visible = (snapshot: Tool.Snapshot) =>
+        new Set([
+          ...snapshot.definitions.map((definition) => definition.name),
+          ...(snapshot.codeModeCatalog?.tools ?? []).flatMap((entry) => (entry.type === "tool" ? [entry.name] : [])),
+        ])
+      for (const id of [build, plan]) {
+        const names = visible(yield* tools.snapshot(rulesFor(agents, id)))
+        expect(names.has("read")).toBe(true)
+        expect(names.has("glob")).toBe(false)
+        expect(names.has("grep")).toBe(false)
+      }
+      for (const id of [general, explore]) {
+        const names = visible(yield* tools.snapshot(rulesFor(agents, id)))
+        expect(names.has("read")).toBe(true)
+        expect(names.has("glob")).toBe(true)
+        expect(names.has("grep")).toBe(true)
+      }
+    }).pipe(Effect.scoped, Effect.provide(toolNode)),
+  )
+})
+
+/** Runs the tool policy plugin against stubbed domains, capturing its three hooks. */
+const runPolicy = Effect.fnUntraced(function* () {
+  let beforeHook: ((input: ToolHooks["execute.before"]) => Effect.Effect<void, Tool.Error>) | undefined
+  let afterHook: ((input: ToolHooks["execute.after"]) => Effect.Effect<void>) | undefined
+  let contextHook: ((input: SessionContext) => Effect.Effect<void>) | undefined
+  yield* ToolPolicyPlugin.Plugin.effect(
+    host({
+      tool: {
+        transform: () => Effect.die("unused tool.transform"),
+        reload: () => Effect.die("unused tool.reload"),
+        list: () => Effect.die("unused tool.list"),
+        hook: (name, callback) => {
+          // Hook names and callbacks are correlated, but TypeScript does not narrow this generic registration API.
+          // oxlint-disable-next-line typescript-eslint/no-unsafe-type-assertion
+          if (name === "execute.before") beforeHook = callback as unknown as typeof beforeHook
+          // oxlint-disable-next-line typescript-eslint/no-unsafe-type-assertion
+          if (name === "execute.after") afterHook = callback as unknown as typeof afterHook
+          return Effect.succeed({ dispose: Effect.void })
+        },
+      },
+      session: {
+        hook: (name, callback) => {
+          if (name === "context") contextHook = callback as typeof contextHook
+          return Effect.succeed({ dispose: Effect.void })
+        },
+      },
+    }),
+  )
+  if (!beforeHook) return yield* Effect.die("tool policy plugin did not register execute.before")
+  if (!afterHook) return yield* Effect.die("tool policy plugin did not register execute.after")
+  if (!contextHook) return yield* Effect.die("tool policy plugin did not register a context hook")
+  return { beforeHook, afterHook, contextHook }
+})
+
+const before = (
+  sessionID: Session.ID,
+  agent: Agent.ID,
+  tool: string,
+): ToolHooks["execute.before"] => ({
+  tool,
+  sessionID,
+  agent,
+  messageID: SessionMessage.ID.make("msg_tool_policy"),
+  id: Tool.CallID.make("call_tool_policy"),
+  input: {},
+})
+
+type ToolErrorEvent = Extract<ToolHooks["execute.after"], { readonly status: "error" }>
+
+const toolError = (
+  sessionID: Session.ID,
+  agent: Agent.ID,
+  tool: string,
+  error: Tool.Error,
+  input: unknown = {},
+): ToolErrorEvent => ({
+  tool,
+  input,
+  sessionID,
+  agent,
+  messageID: SessionMessage.ID.make("msg_tool_policy"),
+  id: Tool.CallID.make("call_tool_policy"),
+  status: "error",
+  error,
+})
+
+type ToolCompletedEvent = Extract<ToolHooks["execute.after"], { readonly status: "completed" }>
+
+const toolCompleted = (
+  sessionID: Session.ID,
+  agent: Agent.ID,
+  tool: string,
+  input: unknown = {},
+  result: { output?: unknown; content?: string; metadata?: Record<string, unknown> } = { content: "ok" },
+): ToolCompletedEvent => ({
+  tool,
+  input,
+  sessionID,
+  agent,
+  messageID: SessionMessage.ID.make("msg_tool_policy"),
+  id: Tool.CallID.make("call_tool_policy"),
+  status: "completed",
+  result,
+})
+
+const request = (
+  sessionID: Session.ID,
+  agent: Agent.ID,
+  messages: Array<Message>,
+  tools: SessionContext["tools"] = {},
+): SessionContext => ({
+  sessionID,
+  agent,
+  model: { id: Model.ID.make("test-model"), providerID: Provider.ID.make("test") },
+  system: [],
+  messages,
+  tools,
+  options: {},
+})
+
+/** A tools map as prepare() hands it to the context hook: one entry per advertised tool. */
+const toolsMap = (names: ReadonlyArray<string>): SessionContext["tools"] =>
+  Object.fromEntries(names.map((name) => [name, { description: `${name} tool`, input: { type: "object" } }]))
+
+const fullToolset = [
+  "read",
+  "glob",
+  "grep",
+  "shell",
+  "edit",
+  "write",
+  "patch",
+  "todowrite",
+  "execute",
+  "webfetch",
+  "subagent",
+  "question",
+]
+
+type Hooks = {
+  readonly beforeHook: (input: ToolHooks["execute.before"]) => Effect.Effect<void, Tool.Error>
+  readonly afterHook: (input: ToolHooks["execute.after"]) => Effect.Effect<void>
+  readonly contextHook: (input: SessionContext) => Effect.Effect<void>
+}
+
+/** Drives one exploration call through the before hook and a settling after hook. */
+const driveCall = Effect.fnUntraced(function* (
+  hooks: Hooks,
+  sessionID: Session.ID,
+  agent: Agent.ID,
+  tool: string,
+  settle: "completed" | "error",
+) {
+  yield* hooks.beforeHook(before(sessionID, agent, tool))
+  yield* settle === "completed"
+    ? hooks.afterHook(toolCompleted(sessionID, agent, tool))
+    : hooks.afterHook(toolError(sessionID, agent, tool, new ToolFailure({ message: "boom" })))
+})
+
+const completeCall = (hooks: Hooks, sessionID: Session.ID, agent: Agent.ID, tool: string) =>
+  driveCall(hooks, sessionID, agent, tool, "completed")
+
+const failCall = (hooks: Hooks, sessionID: Session.ID, agent: Agent.ID, tool: string) =>
+  driveCall(hooks, sessionID, agent, tool, "error")
+
+/** A substantive delegation briefing: comfortably over the substance floor. */
+const briefing = "Map the pricing module end to end: every file, its exports, and who calls them."
+
+/** Settles a subagent call in the after hook with the given input and settled output. */
+const settleSubagent = Effect.fnUntraced(function* (
+  hooks: Hooks,
+  sessionID: Session.ID,
+  agent: Agent.ID,
+  input: { agent: string; prompt: string; background?: boolean; sessionID?: string },
+  output: { sessionID: string; status: string; output: string },
+) {
+  yield* hooks.afterHook(
+    toolCompleted(sessionID, agent, "subagent", input, {
+      output,
+      metadata: { sessionID: output.sessionID, status: output.status },
+    }),
+  )
+})
+
+const blockedShell = (resources: ReadonlyArray<string>) =>
+  new ToolFailure({
+    message: "Permission denied: shell",
+    error: new Permission.BlockedError({ rules: [], permission: "shell", resources: [...resources] }),
+  })
+
+describe("tool policy exploration budget", () => {
+  it.effect("lets the budgeted exploration calls through and rejects the next one", () =>
+    Effect.gen(function* () {
+      const hooks = yield* runPolicy()
+      const sessionID = Session.ID.make("ses_policy_budget")
+      yield* hooks.contextHook(request(sessionID, build, [Message.user("start")]))
+      for (let i = 0; i < MAX_EXPLORATION_CALLS; i++) yield* completeCall(hooks, sessionID, build, "read")
+      const error = yield* hooks.beforeHook(before(sessionID, build, "read")).pipe(Effect.flip)
+      expect(error).toBeInstanceOf(ToolFailure)
+      expect(error.message).toBe(
+        `Exploration budget for this turn is exhausted (${MAX_EXPLORATION_CALLS} direct calls). Use the \`subagent\` tool (agent: \`explore\`) for further exploration; the budget refills after a delegation.`,
+      )
+    }),
+  )
+
+  it.effect("reserves slots for in-flight calls and returns them when a call errors", () =>
+    Effect.gen(function* () {
+      const hooks = yield* runPolicy()
+      const sessionID = Session.ID.make("ses_policy_inflight")
+      yield* hooks.contextHook(request(sessionID, build, [Message.user("start")]))
+      // One parallel block: eight attempts reserve the whole allowance before any settles.
+      for (let i = 0; i < MAX_EXPLORATION_CALLS; i++) yield* hooks.beforeHook(before(sessionID, build, "read"))
+      expect(yield* hooks.beforeHook(before(sessionID, build, "read")).pipe(Effect.flip)).toBeInstanceOf(ToolFailure)
+      // An errored attempt gives its slot back instead of consuming budget: a retry takes
+      // the freed slot and completes, advancing the ladder by exactly one.
+      yield* hooks.afterHook(toolError(sessionID, build, "read", new ToolFailure({ message: "boom" })))
+      yield* hooks.beforeHook(before(sessionID, build, "read"))
+      yield* hooks.afterHook(toolCompleted(sessionID, build, "read"))
+      // The rest of the block settles as errors too, returning their slots.
+      for (let i = 0; i < MAX_EXPLORATION_CALLS - 1; i++)
+        yield* hooks.afterHook(toolError(sessionID, build, "read", new ToolFailure({ message: "boom" })))
+      // Seven more completions fit; the ninth completed call of the turn is refused.
+      for (let i = 0; i < MAX_EXPLORATION_CALLS - 1; i++) yield* completeCall(hooks, sessionID, build, "read")
+      expect(yield* hooks.beforeHook(before(sessionID, build, "read")).pipe(Effect.flip)).toBeInstanceOf(ToolFailure)
+    }),
+  )
+
+  it.effect("does not count exploration calls that error", () =>
+    Effect.gen(function* () {
+      const hooks = yield* runPolicy()
+      const sessionID = Session.ID.make("ses_policy_failed_reads")
+      yield* hooks.contextHook(request(sessionID, build, [Message.user("start")]))
+      for (let i = 0; i < MAX_EXPLORATION_CALLS + 4; i++) yield* failCall(hooks, sessionID, build, "read")
+      // Nothing was consumed: the full toolset is still offered and reads still pass.
+      const tools = toolsMap(fullToolset)
+      yield* hooks.contextHook(request(sessionID, build, [Message.user("start")], tools))
+      expect(Object.keys(tools).sort()).toEqual([...fullToolset].sort())
+      for (let i = 0; i < MAX_EXPLORATION_CALLS; i++) yield* completeCall(hooks, sessionID, build, "read")
+      expect(yield* hooks.beforeHook(before(sessionID, build, "read")).pipe(Effect.flip)).toBeInstanceOf(ToolFailure)
+    }),
+  )
+
+  it.effect("injects the delegation reminder once, after the fifth completed exploration call", () =>
+    Effect.gen(function* () {
+      const hooks = yield* runPolicy()
+      const sessionID = Session.ID.make("ses_policy_reminder")
+      const messages = [Message.user("start")]
+      yield* hooks.contextHook(request(sessionID, build, messages))
+      for (let i = 0; i < REMIND_AT - 1; i++) yield* completeCall(hooks, sessionID, build, "read")
+      yield* hooks.contextHook(request(sessionID, build, messages))
+      expect(messages).toHaveLength(1)
+      yield* completeCall(hooks, sessionID, build, "read")
+      yield* hooks.contextHook(request(sessionID, build, messages))
+      expect(messages).toHaveLength(2)
+      const reminder = messages[0]?.content[0]
+      expect(reminder?.type === "text" && reminder.text).toContain("[system-reminder]")
+      expect(reminder?.type === "text" && reminder.text).toContain(`${REMIND_AT} direct exploration calls`)
+      expect(reminder?.type === "text" && reminder.text).toContain("Delegate remaining exploration")
+      // The reminder fires once per turn, even though it stays visible in this transcript.
+      yield* hooks.contextHook(request(sessionID, build, messages))
+      expect(messages).toHaveLength(2)
