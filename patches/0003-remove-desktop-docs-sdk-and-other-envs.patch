-    state: () => current.state,
-    dispatch,
-    /** Stops every plugin but `keep`, then runs the handoff, or relaunches without one. Rejects when the handoff fails. */
-    restart: (keep: Scope, handoff?: Handoff) =>
-      new Promise<void>((resolve, reject) =>
