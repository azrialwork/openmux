-    return {
-      state: { status: "bound", handler: event.handler },
-      commands: queued.length ? [{ type: "trigger", handler: event.handler, ids: queued }] : [],
-    }
-  }
-
-  if (state.status !== "bound" || state.handler !== event.handler) return { state, commands: [] }
