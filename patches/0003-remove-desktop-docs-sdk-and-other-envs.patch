-      return yield* Effect.callback<Browser.TunnelRead, Error>((resume) => {
-        const done = (value: Effect.Effect<Browser.TunnelRead, Error>, result: BrowserTunnelMachine.ReadOutcome) => {
-          cleanup()
-          outcome = result
-          resume(value)
-        }
