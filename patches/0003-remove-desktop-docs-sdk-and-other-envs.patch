-  const continentLookup = new Map([
-    ...(await lookupRows(opts.files["geo-continent-day"], "day", opts, geoContinentLookup)),
-    ...(await lookupRows(opts.files["geo-continent-week"], "week", opts, geoContinentLookup)),
