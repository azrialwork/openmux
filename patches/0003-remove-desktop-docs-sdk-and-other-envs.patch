-  return {
-    state: { status: "waiting", attempt, failures, progress },
-    effects: [...before, { type: "start-wait", attempt, delayMs }],
-  }
-}
-
-function unchanged(state: MigrationState): MigrationTransition {
-  return { state, effects: [] }
-}
