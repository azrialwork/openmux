-  "stroke-opacity",
-  "stroke-linecap",
-  "stroke-linejoin",
-  "stroke-dasharray",
-  "stroke-dashoffset",
-  "stroke-miterlimit",
-  "opacity",
-  "visibility",
-  "display",
-  "vector-effect",
-  "paint-order",
-  "clip-path",
-  "clip-rule",
-  "clipPathUnits",
-  "mask",
-  "maskUnits",
-  "maskContentUnits",
-  "offset",
-  "stop-color",
-  "stop-opacity",
-  "gradientUnits",
-  "gradientTransform",
-  "spreadMethod",
-  "font-size",
-  "font-weight",
-  "font-family",
-  "letter-spacing",
