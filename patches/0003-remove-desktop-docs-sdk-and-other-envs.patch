-    const label = shortMonths[parsed.getUTCMonth()]
-    if (!label || seen.has(label)) return []
-    seen.add(label)
-    return [
-      {
-        label,
-        left: modelUsagePointX(index, points.length),
-        align: index === 0 ? "start" : index >= points.length - 2 ? "end" : "center",
-      },
