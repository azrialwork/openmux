-  padding: 2rem 3rem !important;
-
-  @media (max-width: 768px) {
-    padding: 1rem 1.5rem !important;
-  }
-}
-
-.expressive-code {
-  margin: 0.75rem 0 3rem 0 !important;
-  border-radius: 6px;
-}
-
-.expressive-code figure {
-  background: var(--color-background-weak) !important;
-}
-
-.expressive-code .frame {
-  box-shadow: none;
-}
-
-@media (prefers-color-scheme: dark) {
-  .shiki,
-  .shiki span {
-    color: var(--shiki-dark) !important;
-    background-color: var(--shiki-dark-bg) !important;
-    /* Optional, if you also want font styles */
-    font-style: var(--shiki-dark-font-style) !important;
-    font-weight: var(--shiki-dark-font-weight) !important;
-    text-decoration: var(--shiki-dark-text-decoration) !important;
-  }
-}
-
-/* Starlight 0.41 relaxed this to `break-word`, so long inline code no longer shrinks: tables reflow and asides overflow on phones. Keep the earlier wrapping. */
-p,
-h1,
-h2,
-h3,
-h4,
-h5,
-h6,
-:not(pre) > code {
-  overflow-wrap: anywhere;
-}
-
-/* Starlight 0.41 adds automatic spacing between CJK and Latin characters. */
-[lang] {
-  text-autospace: no-autospace;
-}
-
-/* Starlight 0.41 dims the language and theme picker labels. */
-:is(starlight-lang-select, starlight-theme-select) label {
-  color: var(--sl-color-gray-1);
-}
-
-:is(starlight-lang-select, starlight-theme-select) label:hover {
-  color: var(--sl-color-gray-2);
-}
-
-/* Starlight 0.41 replaced the fade on mobile menu social links with a color change. */
-.mobile-preferences .social-icons a:hover {
-  opacity: 0.66;
-}
-
-/* The theme styles the search dialog through `aria-label="Search"`, which only matches English pages. Apply the same styles in every language.
-   The CSS minifier keeps only the last of a duplicated prefixed/unprefixed pair, so the unprefixed one goes last. */
-site-search dialog {
-  border: 1px solid var(--sl-color-border);
-  border-radius: 0;
-  background-color: var(--sl-color-bg);
-  box-shadow: var(--sl-shadow-md);
-}
-
-site-search dialog[open] {
-  animation: fadeInScaleUp 0.2s ease forwards;
-}
-
-site-search dialog::backdrop {
-  -webkit-backdrop-filter: blur(2px);
-  backdrop-filter: blur(2px);
-  animation: fadeInBackdrop 0.2s ease forwards;
-}
-
-mobile-starlight-toc nav {
-  -webkit-backdrop-filter: blur(8px);
-  backdrop-filter: blur(8px);
-}
-
-/* Starlight 0.41 keeps the "On this page" column at least a sidebar wide, which narrows the content between 1160px and 1320px. Keep the earlier proportional widths. */
-@media (min-width: 72rem) {
-  .right-sidebar-container {
-    width: calc(var(--sl-sidebar-width) + (100% - var(--sl-content-width) - var(--sl-sidebar-width)) / 2);
-  }
-
-  [data-has-sidebar][data-has-toc] .main-pane {
-    width: calc(var(--sl-content-width) + (100% - var(--sl-content-width) - var(--sl-sidebar-width)) / 2);
-  }
-}
-
-/* Starlight 0.41 turns off iOS text inflation in landscape; keep the browser default. */
-html {
-  -webkit-text-size-adjust: auto;
-  text-size-adjust: auto;
-}
