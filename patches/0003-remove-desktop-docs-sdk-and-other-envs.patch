-function formatMarketDateLabel(label: string) {
-  const parts = marketDateParts(label)
-  const year = new Date().getFullYear()
-  if (parts.start === parts.end) return `${parts.start} ${year}`
-  return `${parts.start} ${year} → ${parts.end} ${year}`
-}
