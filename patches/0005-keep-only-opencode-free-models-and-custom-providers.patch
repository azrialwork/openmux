-            ...choice,
-            delta: {
-              ...choice.delta,
-              reasoning_content: visible || undefined,
-              // Opaque-only scalar reasoning still needs a canonical part for replay.
-              reasoning_details: choice.delta.reasoning_details ?? (marker >= 0 ? [] : undefined),
-            },
-          }
-        : choice,
-    ),
-  })
