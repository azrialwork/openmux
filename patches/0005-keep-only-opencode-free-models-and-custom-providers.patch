-      shared: result[0],
-      pending: pending ? text.slice(-pending) : "",
-      reasoning: state.reasoning + scalar,
-      encrypted: state.encrypted || marker >= 0,
-      signature: delta?.thought_signature ?? state.signature,
-      tools,
