-// Multiplies in GF(2^8) modulo x^8 + x^4 + x^3 + x^2 + 1.
-function multiply(x: number, y: number) {
-  let z = 0
-  for (let i = 7; i >= 0; i--) {
-    z = (z << 1) ^ ((z >>> 7) * 0x11d)
-    z ^= ((y >>> i) & 1) * x
-  }
-  return z
