-function reedSolomonRemainder(data: number[], divisor: number[]) {
-  return data.reduce(
-    (remainder, byte) => {
-      const factor = byte ^ remainder[0]
-      return [...remainder.slice(1), 0].map((value, i) => value ^ multiply(divisor[i], factor))
-    },
-    divisor.map(() => 0),
-  )
-}
