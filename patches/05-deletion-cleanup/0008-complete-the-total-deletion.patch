-  const modules = Array.from({ length: size }, () => Array<boolean>(size).fill(false))
-  const reserved = Array.from({ length: size }, () => Array<boolean>(size).fill(false))
-  drawFunctionPatterns(version, size, (x, y, dark) => {
-    modules[y][x] = dark
-    reserved[y][x] = true
