-  append(bytes.length, version < 10 ? 8 : 16)
-  bytes.forEach((byte) => append(byte, 8))
-  append(0, Math.min(4, capacity * 8 - bits.length))
-  append(0, (8 - (bits.length % 8)) % 8)
