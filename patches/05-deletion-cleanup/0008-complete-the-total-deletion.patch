-  const count = Math.floor(version / 7) + 2
-  return base - ((25 * count - 10) * count - 55) - (version >= 7 ? 36 : 0)
-}
-
-function dataCapacity(version: number) {
-  return Math.floor(rawModules(version) / 8) - ECC_PER_BLOCK[version - 1] * BLOCKS[version - 1]
-}
